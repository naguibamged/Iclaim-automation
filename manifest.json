{
  "manifest_version": 3,
  "name": "Iclaim Automation",
  "version": "1.0.0",
  "description": "Watch a WhatsApp group, search iClaim or the committee site, and send the PDF back.",
  "permissions": ["storage", "tabs", "scripting", "debugger"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://41.33.97.121:1337/*",
    "http://196.219.52.208/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Iclaim Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["shared.js", "content/whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
